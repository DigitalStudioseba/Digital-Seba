# ==============================================================================
# DIGITAL SEBA — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# ARCHITECTURAL NOTICE:
# Digital Seba is a client-side static frontend deployed on Cloudflare Pages.
# The static browser runtime does NOT automatically read `.env` files at build
# time or runtime. Firebase configuration is loaded statically via client-side
# configuration in `assets/js/firebase-init.js`.
#
# This file is provided strictly as a reference template for hypothetical
# future CI/CD build scripts or external deployment pipelines.
#
# SECURITY RULES:
# 1. This file must contain ONLY safe placeholder values.
# 2. NEVER commit real API keys, service-account JSON, private tokens, or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Public Web Client Configuration (Reference Template)
# (Corresponds to public client-facing identifiers in `assets/js/firebase-init.js`)
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_APP_ID=your_app_id_here

# ------------------------------------------------------------------------------
# Optional Custom Domain / Host Settings (Reference Template)
# ------------------------------------------------------------------------------
SITE_URL=https://digitalseba.pages.dev
CUSTOM_DOMAIN=https://digiseba.shop
