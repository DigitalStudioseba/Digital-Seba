rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Superadmin / Project Owner (Hardcoded Google OAuth verified email)
    function isSuperAdmin() {
      return isAuthenticated() &&
             request.auth.token.email == 'digitalsebamail@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    // 2. Check if the current user account is marked as suspended in /users/{uid}
    function isSuspended() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'suspended';
    }

    // 3. Administrator (Superadmin OR active, non-suspended delegated admin in /admins/{uid})
    // A delegated admin whose account is suspended automatically loses admin privileges.
    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        !isSuspended() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Universal schema and data integrity check for user documents
    function isValidUserSchema(userId) {
      return (!('uid' in request.resource.data) || request.resource.data.uid == userId)
          && (!('role' in request.resource.data) || request.resource.data.role in ['user', 'admin'])
          && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'suspended']);
    }

    // ─── ADMINS COLLECTION (LEAST PRIVILEGE) ───
    // Reads: Superadmin or active non-suspended admin verifying their own status.
    // Writes: Strictly Superadmin only. Delegated admins cannot create, modify, or delete admins.
    match /admins/{adminId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == adminId && !isSuspended());
      allow write: if isSuperAdmin();
    }

    // ─── USERS COLLECTION ───
    match /users/{userId} {
      // Read access: owner or any verified active administrator (collection query requires isAdmin)
      allow read: if isOwner(userId) || isAdmin();

      // Creation upon registration / first login:
      // Normal users can only initialize role 'user' and status 'active'.
      // Superadmin can initialize own role 'admin'.
      allow create: if isValidUserSchema(userId) && (
        (isOwner(userId)
         && (!('role' in request.resource.data) || request.resource.data.role == 'user')
         && (!('status' in request.resource.data) || request.resource.data.status == 'active'))
        || isSuperAdmin()
      );

      // Updates:
      // - Normal user: active (non-suspended) users can update safe fields only (cannot alter role, status, isAdmin)
      // - Delegated admin: can update profile and status (suspend/activate), but CANNOT change role or isAdmin
      // - Superadmin: full update authority
      allow update: if isValidUserSchema(userId) && (
        (isOwner(userId)
         && resource.data.status != 'suspended'
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'isAdmin'])))
        || isSuperAdmin()
        || (isAdmin() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])))
      );

      // Deletion: restricted to Superadmin
      allow delete: if isSuperAdmin();
    }

    // ─── PUBLIC CONTACT FORM (STRICT SCHEMA) ───
    // Validated against payload in assets/js/animations.js:370-385
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'submittedAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 3
                    && request.resource.data.email.size() <= 150
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 1
                    && request.resource.data.message.size() <= 5000
                    && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
                    && (!('subject' in request.resource.data) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 200))
                    && (!('submittedAt' in request.resource.data) || (request.resource.data.submittedAt is string && request.resource.data.submittedAt.size() <= 50));
      allow read, update, delete: if isAdmin();
    }

    // ─── PUBLIC NEWSLETTER FORM (STRICT SCHEMA) ───
    // Validated against payload in assets/js/animations.js:340-345
    match /newsletter/{newsletterId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'source'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 3
                    && request.resource.data.email.size() <= 150
                    && request.resource.data.subscribedAt is timestamp
                    && (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 50));
      allow read, update, delete: if isAdmin();
    }

    // ─── DEFAULT FALLBACK (ZERO-TRUST DENIAL) ───
    // All unused collections (including inquiries, service_requests) and unmapped paths are denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
